diff --git a/src/video_core/renderer_software/renderer_software.cpp b/src/video_core/renderer_software/renderer_software.cpp
index 14aabca..d8d02b5 100644
--- a/src/video_core/renderer_software/renderer_software.cpp
+++ b/src/video_core/renderer_software/renderer_software.cpp
@@ -45,7 +45,16 @@ void RendererSoftware::LoadFBToScreenInfo(int i, const Pica::ColorFill& color_fi
     const u8* framebuffer_data = memory.GetPhysicalPointer(framebuffer_addr);
 
     const s32 pixel_stride = framebuffer.stride / bpp;
-    info.height = framebuffer.height;
+    // 800px "wide" mode on the top screen (libctru gfxSetWide): neither the 2D (bit 6) nor the
+    // stereoscopic (bit 5) flag is set and the framebuffer holds twice as many lines. Bits 8-9
+    // are only set by a real buffer swap, which keeps the reset-time register value out of it.
+    u32 lines = framebuffer.height;
+    const bool wide =
+        fb_id == 0 && (framebuffer.format & 0x60) == 0 && (framebuffer.format & 0x300) != 0;
+    if (wide && memory.IsValidPhysicalAddress(framebuffer_addr + framebuffer.stride * lines * 2 - 1)) {
+        lines *= 2;
+    }
+    info.height = lines;
     info.width = pixel_stride;
     info.pixels.resize(info.width * info.height * 4);
 
diff --git a/src/video_core/renderer_software/sw_rasterizer.cpp b/src/video_core/renderer_software/sw_rasterizer.cpp
index 1e82f87..8d244c2 100644
--- a/src/video_core/renderer_software/sw_rasterizer.cpp
+++ b/src/video_core/renderer_software/sw_rasterizer.cpp
@@ -303,8 +303,7 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
 
     // Enter rasterization loop, starting at the center of the topleft bounding box corner.
     // TODO: Not sure if looping through x first might be faster
-    for (u16 y = min_y + 8; y < max_y; y += 0x10) {
-        const auto process_scanline = [&, y] {
+    const auto process_scanline = [&](u16 y) {
             for (u16 x = min_x + 8; x < max_x; x += 0x10) {
                 // Do not process the pixel if it's inside the scissor box and the scissor mode is
                 // set to Exclude.
@@ -467,8 +466,31 @@ void RasterizerSoftware::ProcessTriangle(const Vertex& v0, const Vertex& v1, con
                 }
             }
         };
-        sw_workers.QueueWork(std::move(process_scanline));
+#ifdef __EMSCRIPTEN__
+    // WebAssembly: futex-based sync makes one job per scanline cost more than the scanline
+    // itself. Rasterize small triangles inline, split big ones into one interleaved band per
+    // worker (bands jobs + one wait per triangle instead of one job per scanline).
+    const u32 first_y = min_y + 8;
+    const u32 rows = max_y > first_y ? (max_y - first_y + 0xF) / 0x10 : 0;
+    const u32 bands = static_cast<u32>(std::min<std::size_t>(num_sw_threads, rows / 8));
+    if (bands <= 1) {
+        for (u32 y = first_y; y < max_y; y += 0x10) {
+            process_scanline(static_cast<u16>(y));
+        }
+        return;
+    }
+    for (u32 band = 0; band < bands; band++) {
+        sw_workers.QueueWork([&, band, bands, first_y] {
+            for (u32 y = first_y + band * 0x10; y < max_y; y += 0x10 * bands) {
+                process_scanline(static_cast<u16>(y));
+            }
+        });
+    }
+#else
+    for (u16 y = min_y + 8; y < max_y; y += 0x10) {
+        sw_workers.QueueWork([&, y] { process_scanline(y); });
     }
+#endif
     sw_workers.WaitForRequests();
 }
 
